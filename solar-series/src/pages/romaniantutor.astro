---
import Layout from '../layouts/Layout.astro';
import IframeWrapper from '../components/IframeWrapper.astro';
---

<Layout title="Romanian Language Tutor - Learn Romanian with AI">
	<section class="project-header">
		<div class="container">
			<h1>🇷🇴 Romanian Language Tutor</h1>
			<p class="subtitle">Learn Romanian with AI-Powered Guidance</p>
		</div>
	</section>

	<section class="project-description">
		<div class="container">
			<h2>Master Romanian Language</h2>
			<p>
				Romanian Language Tutor is an interactive, AI-powered language learning tool designed to help you master Romanian
				at your own pace. Whether you're a beginner learning basic phrases or an advanced learner perfecting your fluency,
				this tutor provides personalized guidance with real-time feedback and interactive conversation practice.
			</p>

			<h3>Features</h3>
			<ul class="features-list">
				<li>Interactive conversation practice with AI feedback</li>
				<li>Real-time pronunciation guidance with microphone support</li>
				<li>Vocabulary building and grammar explanations</li>
				<li>Personalized learning paths tailored to your level</li>
				<li>Cultural context and practical usage examples</li>
			</ul>
		</div>
	</section>

	<IframeWrapper src="https://romanianlanguagetutor-10013616.chipp.ai" title="Romanian Language Tutor" />

	<section class="cta-section">
		<div class="container">
			<h2>Ready to Learn?</h2>
			<p>Interact with the Romanian Language Tutor above, or explore our other projects.</p>
			<a href="/projects" class="btn btn-primary">Back to Projects</a>
		</div>
	</section>
</Layout>

<style>
	.project-header {
		background: linear-gradient(135deg, #f5f7ff 0%, #ffffff 100%);
		padding: 4rem 2rem;
		text-align: center;
		border-bottom: 1px solid #e0e0e0;
	}

	.project-header h1 {
		font-size: 3.5rem;
		margin-bottom: 0.5rem;
		color: #1a1a1a;
		background: linear-gradient(135deg, #6366f1, #4f46e5);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.subtitle {
		font-size: 1.5rem;
		color: #4b5563;
		font-style: italic;
	}

	.project-description {
		padding: 4rem 2rem;
		background: #fafafa;
	}

	.container {
		max-width: 900px;
		margin: 0 auto;
	}

	.project-description h2 {
		margin-bottom: 1.5rem;
	}

	.project-description p {
		font-size: 1.1rem;
		line-height: 1.8;
		color: #4b5563;
		margin-bottom: 2rem;
	}

	.project-description h3 {
		margin-top: 2rem;
		margin-bottom: 1rem;
		color: #1a1a1a;
	}

	.features-list {
		list-style: none;
		padding: 0;
		margin-bottom: 2rem;
	}

	.features-list li {
		padding: 0.75rem 0;
		padding-left: 2rem;
		color: #4b5563;
		position: relative;
		font-size: 1.05rem;
	}

	.features-list li:before {
		content: '✓';
		position: absolute;
		left: 0;
		color: #6366f1;
		font-weight: bold;
		font-size: 1.2rem;
	}

	.cta-section {
		padding: 3rem 2rem;
		text-align: center;
		background: #ffffff;
		border-top: 1px solid #e0e0e0;
	}

	.cta-section h2 {
		margin-bottom: 1rem;
	}

	.cta-section p {
		color: #4b5563;
		margin-bottom: 2rem;
		font-size: 1.1rem;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 2rem;
		border-radius: 8px;
		font-weight: 600;
		font-size: 1rem;
		transition: all 0.3s ease;
		border: 2px solid transparent;
		text-decoration: none;
	}

	.btn-primary {
		background: #6366f1;
		color: white;
		box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
	}

	.btn-primary:hover {
		background: #4f46e5;
		transform: translateY(-2px);
		box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
	}

	@media (max-width: 768px) {
		.project-header {
			padding: 2rem 1rem;
		}

		.project-header h1 {
			font-size: 2.5rem;
		}

		.subtitle {
			font-size: 1.2rem;
		}

		.project-description {
			padding: 2rem 1rem;
		}

		.project-description p,
		.features-list li {
			font-size: 1rem;
		}
	}
</style>
